# ============================================================
# YouTube to Apple Podcasts 配置模板
# ============================================================

# 1. 目标 YouTube 频道链接（支持 /@ChannelName 或 /channel/UCxxx 或播放列表链接）
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@ChannelName

# 2. Cloudflare R2 配置（在 Cloudflare Dashboard -> R2 获取）
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=my-podcast-bucket

# R2 存储桶公开访问域名（例如：https://pub-xxxxxxxx.r2.dev 或绑定自定义域名 https://podcast.yourdomain.com）
# 注意：末尾不要带斜杠 /
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# 3. 播客设置（可选）
MAX_EPISODES=15
PODCAST_LANGUAGE=zh-cn
PODCAST_CATEGORY=Technology

# 可选自定义标题与作者（留空则自动抓取 YouTube 频道信息）
# PODCAST_TITLE=
# PODCAST_AUTHOR=
# PODCAST_DESCRIPTION=
# PODCAST_IMAGE_URL=

# 4. Telegram 通知设置（可选，有新单集发布时推送到手机）
# TELEGRAM_BOT_TOKEN=8955999825:AAFRlyN390_DXT8gg8auYUItxcJ0O1MyCew
# TELEGRAM_CHAT_ID=5584552077

# 5. 调试模式（设为 true 时仅在本地生成，不上传 R2）
DRY_RUN=false

# ============================================================
# 抖音播客配置 (可选)
# ============================================================
# DOUYIN_COOKIE="sessionid=...; passport_csrf_token=..."
# CHINA_PROXY=http://127.0.0.1:1055

# ============================================================
# Bilibili 播客配置 (可选)
# ============================================================
# BILI_COOKIES="buvid3=...; SESSDATA=...; bili_jct=..."
# BILI_MAX_EPISODES=1
